{
  "cmake.useCMakePresets": "always",
  "cmake.statusbar.visibility": "visible",

  // Use winlibs tools
  "cmake.cmakePath": "C:/mingw64/bin/cmake.exe",
  "cmake.generator": "Ninja",

  "cmake.configureEnvironment": {
    "PATH": "C:/mingw64/bin;${env:PATH}"
  },
  "cmake.buildEnvironment": {
    "PATH": "C:/mingw64/bin;${env:PATH}"
  },

  // Make the CMake “Debug” button inject DLL paths + fix source mapping
"cmake.debugConfig": {
  "stopAtEntry": false,
  "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
  "miDebuggerArgs": "-readnow",                     // load symbols up front
  "externalConsole": true,
  "environment": [
    {
      "name": "PATH",
      "value": "C:/mingw64/bin;C:/mingw64/local-wx-debug/bin;C:/mingw64/local-wx-debug/lib/gcc_x64_dll;C:/mingw64/local-wxpdfdoc-debug/bin;C:/mingw64/local-wxpdfdoc-debug/lib/gcc_x64_dll;C:/mingw64/local-3rdparty-debug/bin;${env:PATH}"
    }
  ],
  "setupCommands": [
    { "text": "show substitute-path" },
    { "text": "show environment PATH" },
    { "text": "-enable-pretty-printing" }
  ],
  "logging": { "engineLogging": true, "trace": true, "traceResponse": true }
},
